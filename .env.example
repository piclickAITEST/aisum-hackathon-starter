# AISUM MCP server — given to your team as one key
MCP_URL=https://acts.aedi.ai/mcp
MCP_API_KEY=replace-with-your-team-key

# LLM gateway — the other key you're given. Same gateway as every other team.
OPENAI_BASE_URL=https://<gateway-host-given-with-your-key>/v1
OPENAI_API_KEY=sk-...
MODEL=gpt-5.6-luna

# Firebase — public client config for Google sign-in. Not secret: it identifies the
# project, it does not grant anything. Get these from your Firebase project settings
# (Project settings -> General -> Your apps -> SDK setup and configuration).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
